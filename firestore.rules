rules_version = '2';

// 스쿼드 메이커 보안 규칙
//  👀 방문자 (로그인 안 함)  : 보기만
//  ✏️ 일반 회원 (구글 로그인) : 골·라인업·팀 나누기·경기 만들기/수정·선수 추가·선호 포지션
//  🛡️ 관리자 (최고 관리자가 지정): + 경기 삭제, 선수 삭제, 별점 수정, 백업 불러오기
//  👑 최고 관리자 (아래 이메일)  : + 관리자 지정·해제
//
// ★ 아래 최고 관리자 이메일 한 곳만 본인 이메일로 두고,
//   Firebase 콘솔 → Firestore → 규칙 탭에 통째로 붙여넣은 뒤 "게시"를 누르세요.
//   관리자 지정·해제는 앱의 ⚙️ 설정에서 해요.

service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return signedIn() && myEmail() == 'ehdrnch@gmail.com';   // ← 최고 관리자 이메일
    }

    function isAdmin(g) {
      return isOwner() || (
        signedIn()
        && exists(/databases/$(database)/documents/recorders/$(g))
        && myEmail() in get(/databases/$(database)/documents/recorders/$(g)).data.get('admins', [])
      );
    }

    // 관리자 명단 { owner, admins: [...] }: 관리자끼리만 볼 수 있고, 최고 관리자만 바꿔요
    match /recorders/{g} {
      allow read: if isOwner() || (signedIn() && myEmail() in resource.data.get('admins', []));
      allow write: if isOwner();
    }

    // 선수: 로그인하면 추가·수정 가능 (별점은 관리자만 바꿀 수 있어요), 삭제는 관리자만
    match /groups/{g}/players/{pid} {
      allow read: if true;
      allow create: if signedIn() && (isAdmin(g) || request.resource.data.get('skill', 3) == 3);
      allow update: if signedIn() && (isAdmin(g) || request.resource.data.get('skill', 3) == resource.data.get('skill', 3));
      allow delete: if isAdmin(g);
    }

    // 경기: 로그인하면 만들고 고칠 수 있고 (골, 출전 선수, 빨래 당번…), 삭제는 관리자만
    match /groups/{g}/matches/{mid} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin(g);
    }

    // 오늘 라인업·팀 나누기
    match /groups/{g}/meta/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
