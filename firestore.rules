rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // 이메일 원문을 웹 저장소에 나열하지 않고 인증된 이메일의 SHA-256을 비교해요.
    function isAdmin() {
      return signedIn() && request.auth.token.email is string
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in [
          '893fd79cf280723a79c23be7440fde21be42fd3f077b31814166e8ca2fee593d',
          '1b52994e566bb235b74637e3d644f7723d43c623665974ea6a294db7af435494',
          'e67d9de4882bf1261f7d5ac469311c6057f6bf234b030fd3a92076cf44fc85b2',
          '43e785ffccd60b3d7af673fc90d264b35136897e957563632e2763bbb5b5cbb9'
        ];
    }

    match /groups/{g} {
      // 과거 문서에는 이름과 티어가 함께 있어요. 이전 후에도 관리자만 읽을 수 있어요.
      match /players/{id} {
        allow read: if isAdmin();
      }
      match /directory/v42 {
        allow read: if true;
        allow create, update: if isAdmin() && request.resource.data == {'ready': true};
      }
      match /playerProfiles/{id} {
        allow read: if true;
        allow create, update: if (isAdmin() ||
          (signedIn() && exists(/databases/$(database)/documents/groups/$(g)/directory/v42)))
          && !request.resource.data.keys().hasAny(['tier', 'skill']);
        allow delete: if isAdmin();
      }
      match /playerTiers/{id} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['tier'])
          && request.resource.data.tier in ['Moment', 'S', 'A', 'B', 'C', 'F']
          && existsAfter(/databases/$(database)/documents/groups/$(g)/playerProfiles/$(id));
      }
      match /matches/{id} {
        allow read: if true;
        allow create, update: if signedIn();
        allow delete: if isAdmin();
      }
      match /meta/{id} {
        allow read: if true;
        allow write: if signedIn();
      }
    }
  }
}
