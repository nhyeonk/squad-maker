rules_version = '2';

// 스쿼드 메이커 보안 규칙
// - 누구나 기록을 볼 수 있어요 (링크만 있으면 로그인 없이)
// - 기록 입력은 관리자 + 관리자가 앱에서 추가한 기록자만
// - 기록자 명단(recorders)은 관리자만 바꿀 수 있어요
//
// ★ 아래 OWNER 이메일 한 곳만 본인 이메일로 바꾸고,
//   Firebase 콘솔 → Firestore → 규칙 탭에 통째로 붙여넣은 뒤 "게시"를 누르세요.
//   이후 기록자는 친구가 앱에서 "기록자 신청" → 관리자가 ⚙️ 설정에서 승인해요.

service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return signedIn() && myEmail() == 'ehdrnch@gmail.com';   // ← 관리자 이메일
    }

    function isRecorder(groupId) {
      return isOwner() || (
        signedIn()
        && exists(/databases/$(database)/documents/recorders/$(groupId))
        && myEmail() in get(/databases/$(database)/documents/recorders/$(groupId)).data.emails
      );
    }

    // 기록자 명단: 관리자와 명단에 있는 기록자만 읽기 (다른 사람에겐 이메일이 안 보여요), 관리자만 쓰기
    match /recorders/{groupId} {
      allow read: if isOwner() || (signedIn() && myEmail() in resource.data.emails);
      allow write: if isOwner();
    }

    // 기록자 신청: 본인은 자기 신청만 만들고/취소하고, 관리자는 전체를 보고 승인·거절
    match /requests/{groupId}/items/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'at']);
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    // 선수, 경기, 라인업
    match /groups/{groupId}/{document=**} {
      allow read: if true;
      allow write: if isRecorder(groupId);
    }
  }
}
